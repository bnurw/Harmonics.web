# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://user:password@localhost:5432/harmonics?schema=public"

# AUTHENTICATION & JWT
JWT_SECRET="harmonics-secure-jwt-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# SECURE OWNER PROVISIONING
OWNER_EMAIL="owner@harmonics.app"
OWNER_INITIAL_PASSWORD="HarmonicsOwner2026!"

# OBJECT STORAGE & UPLOADS (Configurable local or S3 provider)
UPLOAD_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
MAX_AUDIO_SIZE_MB="50"
MAX_IMAGE_SIZE_MB="5"
